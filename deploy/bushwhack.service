[Unit]
Description=Bushwhack router template service
Documentation=https://github.com/brennanMKE/Bushwhack
After=network.target

[Service]
Type=simple
User=bushwhack
Group=bushwhack

# No env file: the service is stateless and needs no secrets. PORT comes from
# the photon port registry drop-in (bushwhack.service.d/50-port.conf).
ExecStart=/usr/local/bin/bushwhack
Restart=on-failure
RestartSec=5

# Shuts down gracefully on SIGTERM (cmd/server/main.go, 15 s budget).
KillSignal=SIGTERM
TimeoutStopSec=20

# Geometry is CPU and memory hungry on hostile input. Keep it from crowding
# out the other services on a t4g.small. The app also caps uploads at 2 MB,
# a 10 s deadline and 4 concurrent jobs.
Environment=GOMEMLIMIT=200MiB
MemoryMax=320M
CPUQuota=150%

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
